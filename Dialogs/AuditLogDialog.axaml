<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MenuProUI.Dialogs.AuditLogDialog"
        Width="1180" Height="680"
        WindowStartupLocation="CenterOwner"
        Title="Auditoria"
        CanResize="True">
  <Grid RowDefinitions="Auto,Auto,*" Margin="14" RowSpacing="10">
    <Grid ColumnDefinitions="2*,*,*,*,Auto,Auto,Auto" ColumnSpacing="8">
      <TextBox Name="SearchBox" Watermark="Buscar em ação, entidade e detalhes..." />
      <ComboBox Grid.Column="1" Name="ActionFilterBox"/>
      <ComboBox Grid.Column="2" Name="EntityFilterBox"/>
      <ComboBox Grid.Column="3" Name="SortByBox"/>
      <Button Grid.Column="4" Content="Aplicar" Click="OnApplyFilter"/>
      <Button Grid.Column="5" Content="Exportar CSV" Click="OnExportCsv"/>
      <Button Grid.Column="6" Content="Exportar JSON" Click="OnExportJson"/>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="180,120,140,220,*" Margin="0,4,0,0" Opacity="0.85">
      <TextBlock Grid.Column="0" Text="Timestamp" FontWeight="Bold"/>
      <TextBlock Grid.Column="1" Text="Ação" FontWeight="Bold"/>
      <TextBlock Grid.Column="2" Text="Entidade" FontWeight="Bold"/>
      <TextBlock Grid.Column="3" Text="Nome" FontWeight="Bold"/>
      <TextBlock Grid.Column="4" Text="Detalhes" FontWeight="Bold"/>
    </Grid>

    <ListBox Grid.Row="2" Name="EventsListBox">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Padding="6" CornerRadius="6">
            <Grid ColumnDefinitions="180,120,140,220,*">
              <TextBlock Grid.Column="0" Text="{Binding TimestampUtc}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="1" Text="{Binding Action}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="2" Text="{Binding EntityType}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="3" Text="{Binding EntityName}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="4" Text="{Binding Details}" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</Window>
